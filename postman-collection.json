    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "x-api-key", "value": "{{accountsApiKey}}", "disabled": true },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "disabled": true }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/intents", "host": ["{{baseUrl}}"], "path": ["api", "payments", "intents"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"subscriptionFee\",\n  \"amount\": 5000,\n  \"currency\": \"eur\",\n  \"memberId\": \"{{memberId}}\"\n}"
            }
          }
        },
        {
          "name": "Reconcile Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "x-api-key", "value": "{{accountsApiKey}}", "disabled": true },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "disabled": true }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/reconcile", "host": ["{{baseUrl}}"], "path": ["api", "payments", "reconcile"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"evt_test_123\",\n  \"type\": \"payment_intent.succeeded\",\n  \"payment\": {\n    \"paymentIntentId\": \"{{paymentIntentId}}\",\n    \"amount\": 5000,\n    \"currency\": \"eur\",\n    \"status\": \"succeeded\"\n  }\n}"
            }
          }
        },
        {
          "name": "List Payments By Members (Batch)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "x-api-key", "value": "{{accountsApiKey}}", "disabled": true }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/batch", "host": ["{{baseUrl}}"], "path": ["api", "payments", "batch"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberIds\": [\"{{memberId}}\"],\n  \"status\": \"succeeded\",\n  \"purpose\": \"subscriptionFee\"\n}"
            }
          }
        },
        {
          "name": "Record External Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "x-api-key", "value": "{{accountsApiKey}}", "disabled": true },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "disabled": true }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/record-external", "host": ["{{baseUrl}}"], "path": ["api", "payments", "record-external"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direction\": \"in\",\n  \"amount\": 1000,\n  \"currency\": \"eur\",\n  \"reason\": \"Bank transfer\",\n  \"memberId\": \"{{memberId}}\",\n  \"externalRef\": \"EXT-REF-001\"\n}"
            }
          }
        },
        {
          "name": "Get Payment By Stripe ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "x-api-key", "value": "{{accountsApiKey}}", "disabled": true }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/by-stripe/{{paymentIntentId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "by-stripe", "{{paymentIntentId}}"] }
          }
        },
        {
          "name": "Capture Existing Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/intents/{{paymentIntentId}}/capture",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "intents", "{{paymentIntentId}}", "capture"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profileId\": \"\",\n  \"memberId\": \"{{memberId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Captures a manual-capture PaymentIntent currently at requires_capture. profileId/memberId are optional - if supplied, they're attached to the Payment immediately before capture so the resulting GL entry is attributed correctly (used by events-service at registration approval, and by application-payment approval)."
          }
        },
        {
          "name": "Cancel Existing Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/intents/{{paymentIntentId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "intents", "{{paymentIntentId}}", "cancel"]
            },
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
            "description": "Releases the authorization hold on a PaymentIntent (requires_capture -> canceled) - no refund, since nothing was captured. If it's already succeeded instead, this just flags the Payment as refund_required rather than cancelling (a real refund needs POST /api/payments/refunds)."
          }
        },
        {
          "name": "Attach Registration To Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-tenant-id", "value": "{{tenantId}}", "disabled": true },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}", "disabled": true }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/intents/{{paymentIntentId}}/attach-registration",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "intents", "{{paymentIntentId}}", "attach-registration"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationId\": \"{{registrationId}}\",\n  \"productCode\": \"\",\n  \"eventCategoryCode\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Backfills registrationId/productCode/eventCategoryCode onto a Payment whose PaymentIntent was created directly against POST /payments/intents (purpose=eventRegistration|courseRegistration) BEFORE the events-service Registration existed - the portal/mobile flow, which authorizes payment first and only calls events-service's POST /registrations afterward. events-service calls this internally right after creating the Registration; it's exposed here mainly for manual testing/inspection. Returns the PaymentIntent's live Stripe status (status/stripeStatus/amount/currency) so the caller can verify it rather than assume."
          }
        },
